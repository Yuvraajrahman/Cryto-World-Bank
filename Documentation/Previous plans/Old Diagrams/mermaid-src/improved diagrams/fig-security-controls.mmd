title: Smart-Contract Security Controls - UUPS, EIP-712, Granular Pause
---
flowchart TB
    classDef step  fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef chain fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef actor fill:#FFFFFF,stroke:#1F1F1F,stroke-width:1.2px,color:#111111

    subgraph A[" UUPS upgrade path "]
        direction LR
        U1["Safe 3-of-5 proposer"]:::actor
        U2["upgradeTo()"]:::step
        U3["TimeLock 24–48 h"]:::chain
        U4["New implementation"]:::chain
        U1 --> U2 --> U3 --> U4
    end

    subgraph B[" EIP-712 sign-in "]
        direction LR
        E1["Typed-data payload"]:::step
        E2["Wallet signature"]:::actor
        E3["recoverAddress()"]:::chain
        E4["JWT 15 min"]:::chain
        E1 --> E2 --> E3 --> E4
    end

    subgraph C[" Granular pause registry "]
        direction LR
        P1["WB Admin"]:::actor
        P2["pauseFunction()"]:::step
        P3["functionPaused map"]:::chain
        P4["The Graph index"]:::chain
        P1 --> P2 --> P3 --> P4
    end

    A ~~~ B ~~~ C
