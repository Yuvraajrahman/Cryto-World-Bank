flowchart TB
    classDef schema fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef iface fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef tier  fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef note  fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111,stroke-dasharray:3 3

    WAL(("Borrower wallet<br/>KYC-verified")):::schema

    subgraph SBT[" CreditPassportSBT (non-transferable) "]
        direction TB
        F1["creditScore : uint16<br/>(0–1000)"]:::schema
        F2["openLoans : uint8<br/>(simultaneous cap)"]:::schema
        F3["completedCycles : uint16<br/>(repayment history)"]:::schema
        F4["lastDefault : uint64<br/>(Unix ts · permanent)"]:::schema
        F5["riskTier : uint8<br/>(Bronze→Diamond)"]:::schema
    end

    IFACE["ICreditPassport.getScore(wallet)<br/>→ (riskTier, repaymentCount, hasDefault)"]:::iface

    subgraph TIERS[" Max loan bands (USDC) "]
        direction LR
        T1["Bronze · 50"]:::tier
        T2["Silver · 250"]:::tier
        T3["Gold · 1,000"]:::tier
        T4["Platinum · 5,000"]:::tier
        T5["Diamond · 25,000"]:::tier
    end

    WAL --> SBT
    SBT --> IFACE
    F5 --> TIERS
    IFACE -. "read by LB · GroupPool ·<br/>external protocols" .-> EXT["Cross-protocol composability"]:::note
    SBT -. "never revoked · GDPR pseudonymous<br/>(wallet + tier + ts only on-chain)" .-> GDPR["Data-minimization note"]:::note
