---
title: Multi-Entity and Cross-Tier Capital Operations
---
flowchart TB
    classDef bank fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef contract fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef note fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111,stroke-dasharray:3 3

    subgraph R1[" "]
        direction LR
        subgraph A[" (a) InterBankLendingPool "]
            direction TB
            S1["LB surplus"]:::bank --> IBLP["IBLP_LB"]:::contract
            S2["LB deficit"]:::bank --> IBLP
            IBLP -. "r_IB ≤ r_down − δ" .-> NoteA["Kinked rate check"]:::note
        end
        subgraph B[" (b) UpwardDepositFacility "]
            direction TB
            LB1["LB surplus"]:::bank --> UDF["UDF"]:::contract --> NB1["NB → WB cascade"]:::bank
        end
        subgraph C[" (c) SyndicatedLoan "]
            direction TB
            LA["Lead Arranger"]:::bank --> SYN["SyndicatedLoan"]:::contract
            CL["Co-Lenders subscribe"]:::bank --> SYN
            SYN -- "≥90% funded · 75% confirm" --> BR["Borrower disbursement"]:::bank
        end
    end

    subgraph R2[" "]
        direction LR
        subgraph D[" (d) TranchedPool "]
            direction TB
            SR["Senior tranche"]:::bank --> TP["TranchedPool"]:::contract
            JR["Junior tranche"]:::bank --> TP
        end
        subgraph E[" (e) TreasurySwap "]
            direction TB
            NB2["NB ETH reserve"]:::bank --> TS["TreasurySwap"]:::contract --> LB2["LB USDC liquidity"]:::bank
        end
        subgraph F[" (f) NettingEngine "]
            direction TB
            Q["Queued bilateral obligations"]:::bank --> NE["NettingEngine"]:::contract --> SET["Single net settlement"]:::bank
        end
    end

