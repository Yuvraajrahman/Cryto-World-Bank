flowchart TB
    classDef proc  fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef store fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef chain fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef note  fill:#FFFFFF,stroke:#1F1F1F,stroke-width:1px,color:#111111,stroke-dasharray:3 3

    subgraph ML[" Off-chain ML service "]
        FEAT["Feature engineering<br/>18 behavioral + 4 app features"]:::proc
        RF["Random Forest + Isolation Forest<br/>+ stacking meta-learner"]:::proc
        SHAP["SHAP vector + Authority Brief"]:::proc
        FEAT --> RF --> SHAP
    end

    subgraph DON[" Chainlink Functions DON (primary) "]
        N1["Node 1"]:::proc
        N2["Node 2"]:::proc
        N3["Node 3"]:::proc
        CONS["DON consensus<br/>before on-chain commit"]:::proc
        N1 & N2 & N3 --> CONS
    end

    subgraph CHAIN[" On-chain contracts "]
        LC["LoanController<br/>commitRiskScore → revealScore"]:::chain
        LB["LocalBankPool<br/>approve gated on SCORE_REVEALED"]:::chain
