---
title: Solidarity Group Lending — Full Lifecycle Activity Flow
---
flowchart TB
    classDef step  fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef dec   fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef ctrl  fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef chain fill:#E8E8E8,stroke:#1F1F1F,stroke-width:1.2px,color:#111111

    subgraph FORM[" Formation and eligibility "]
        direction LR
        F1["Form LOAN_GROUP<br/>3–20 members"]:::step
        F2["Collateral pool or<br/>cold-start tier"]:::step
        F3["SBT + DTI gate"]:::ctrl
        F1 --> F2 --> F3
    end

    subgraph APPLY[" Application and approval "]
        direction LR
        A1["Collective USDC application"]:::step
        A2["Unanimous consent"]:::step
        A3{Approver?}:::dec
        A1 --> A2 --> A3
    end

    subgraph SERVE[" Disbursement and repayment "]
        direction LR
        S1["Share_i = Total / N"]:::step
        S2["Per-member installments"]:::step
        S3["Mutual liability pool"]:::chain
        S1 --> S2 --> S3
    end

    subgraph CLOSE[" Credit progression "]
        direction LR
        C1["Update SBT history"]:::chain
        C2["≥3 cycles → ML tier"]:::step
        C1 --> C2
    end

    FORM --> APPLY --> SERVE --> CLOSE
