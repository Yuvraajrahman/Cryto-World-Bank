flowchart TB
  FV["22-dim feature vector<br/>(18 behavioural + 4 application)"]
  RF["Random Forest<br/>fraud probability p_f (Platt-scaled)"]
  SHAP["SHAP TreeExplainer<br/>per-feature Shapley attributions"]
  IF["Isolation Forest<br/>anomaly score s(x,n)"]
  DEV["Feature-deviation report<br/>(applicant value, median, percentile)"]
  ST["Stacking meta-learner (logistic)<br/>composite score s in [0,1]"]

  subgraph OUT["Audience-specific outputs"]
    direction TB
    O1["Client: top-3 SHAP reasons (plain language)"]
    O2["Approver: SHAP waterfall + anomaly table + s"]
    O3["Auditor: full shap_vector, anomaly score, hashes"]
  end

  FV --> RF --> SHAP
  FV --> IF --> DEV
  RF --> ST
  IF --> ST
  ST --> OUT
  SHAP --> O1
  SHAP --> O2
  DEV --> O2
  SHAP --> O3
  DEV --> O3

  classDef apex fill:#D6E4F7,stroke:#1B1B1B,stroke-width:1.2px,color:#111111;
  classDef mid fill:#EAF1FB,stroke:#1B1B1B,stroke-width:1.1px,color:#111111;
  classDef note fill:#F2F4F7,stroke:#8A8A8A,stroke-width:1px,color:#111111;
  class FV apex;
  class RF,SHAP,IF,DEV,ST mid;
  class O1,O2,O3 note;
