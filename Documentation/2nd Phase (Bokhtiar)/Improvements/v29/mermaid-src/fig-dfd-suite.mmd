---
title: Data-Flow Diagrams — Context (Level-0) and Level-1 Decomposition
---
flowchart TB
    classDef ext   fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef proc  fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef store fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111,stroke-dasharray:2 2
    classDef sys   fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.4px,color:#111111

    subgraph L0[" Level-0 Context Diagram "]
        direction LR
        BORR(("Borrower")):::ext
        APV(("Approver / LB Operator")):::ext
        REG(("Regulator")):::ext
        DON(("Chainlink DON<br/>Functions · Feeds · Auto")):::ext
        AGT(("AI Agent<br/>Qwen3-8B · MCP")):::ext
        KYCp(("zkKYC Provider")):::ext
        CWB["Crypto World Bank Platform<br/>Polygon zkEVM Cardona"]:::sys
        BORR -- "loan req / installment / chat" --> CWB
        CWB -- "status / USDC disbursement" --> BORR
        APV -- "review / approve / SAR" --> CWB
        CWB -- "queue / Authority Brief" --> APV
        AGT -- "confirmed write tools" --> CWB
        CWB -- "SSE stream · context" --> AGT
        REG <-- "read-only audit feed" --> CWB
        DON <-- "score commit · prices · upkeep" --> CWB
        KYCp -- "VC / Groth16 attestation" --> CWB
    end

    subgraph L1[" Level-1: Core Lending Subsystem "]
        direction LR
        P1["P1.1 Loan Origination<br/>(Express API)"]:::proc
        P1b["P1.2 ML Risk Scoring<br/>(Functions primary · relay fallback)"]:::proc
        P1c["P1.3 Disbursement<br/>(LocalBank · USDC)"]:::proc
        P1d["P1.4 Installment Engine<br/>(Automation checkUpkeep)"]:::proc
        D1[("D1 PostgreSQL<br/>loans · installments")]:::store
        D2[("D2 On-chain state<br/>(EVM)")]:::store
        D3[("D3 AI_ML_LOG")]:::store
        D4[("D4 SESSIONS")]:::store
        D5[("D5 AGENT_ACTION_LOG<br/>(append-only)")]:::store
        P1 --> P1b --> P1c --> D2
        P1 --> D1
        P1d --> D1
        P1d --> D2
        P1b --> D3
        P1 --> D4
        P1 --> D5
    end

    subgraph L1B[" Level-1: Deposit, IBLP, FX, Netting "]
        direction LR
        Q1["Q1.1 SavingsVault /<br/>FixedDeposit"]:::proc
        Q2["Q1.2 InterBankLendingPool"]:::proc
        Q3["Q1.3 TreasurySwap (FX)"]:::proc
        Q4["Q1.4 NettingEngine /<br/>settlePartial"]:::proc
        E1[("E1 deposits, accounts")]:::store
        E2[("E2 interbank_loan,<br/>upward_deposit")]:::store
        E3[("E3 treasury_swap")]:::store
        E4[("E4 netting_batch,<br/>netting_entry · audit_logs")]:::store
        Q1 --> E1
        Q2 --> E2
        Q3 --> E3
        Q4 --> E4
    end
