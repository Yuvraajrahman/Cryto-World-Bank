---
title: Dual Governance Path — TimeLock vs Security Council
---
flowchart TB
    classDef std   fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef emerg fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef actor fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef deny  fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111,stroke-dasharray:4 4

    subgraph STD[" Standard path — planned changes "]
        direction TB
        P1["Safe proposer<br/>(3-of-5 WB Admin)"]:::actor
        P2["Propose: upgrade · parameter ·<br/>role grant · reserve ratio"]:::std
        P3["TimeLockController<br/>24–48 h delay"]:::std
        P4["Execute after timelock<br/>· state preserved (UUPS)"]:::std
        P1 --> P2 --> P3 --> P4
    end

    subgraph EMRG[" Emergency path — Security Council "]
        direction TB
        E1["Security Council<br/>4-of-7 Safe multisig<br/>(distinct from WB_ADMIN)"]:::actor
        E2["Pre-approved emergency types only:<br/>pause · upgrade · role revocation"]:::emerg
        E3["Execute within 2 h<br/>(no TimeLock)"]:::emerg
        E4["Mandatory post-incident disclosure<br/>on-chain within 48 h"]:::emerg
        E1 --> E2 --> E3 --> E4
    end

    X["❌ Cannot change system parameters<br/>or reserve ratios"]:::deny
    E2 -. "blocked actions" .-> X

    NOTE["Mirrors Aave Guardian + ShortExecutor<br/>MakerDAO Emergency Shutdown Module"]:::actor
