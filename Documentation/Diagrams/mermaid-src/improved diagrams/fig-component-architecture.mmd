flowchart TB
    classDef step fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef store fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef chain fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef opt fill:#FFFFFF,stroke:#1F1F1F,stroke-width:1.2px,color:#111111,stroke-dasharray:5 4

    subgraph TOP[" Client and API tier "]
        direction LR
        UI["React SPA<br/>primary UI"]:::step
        AA["ERC-4337 accounts"]:::step
        API["Express REST API"]:::step
        PG[("PostgreSQL")]:::store
        UI --> API --> PG
        AGUI["Agent UI (optional)"]:::opt -.-> API
    end

    subgraph MID[" Analytics and ML "]
        direction LR
        ML["FastAPI · RF · SHAP"]:::step
        AG["Qwen3 + MCP (optional)"]:::opt
        CL["Chainlink Functions"]:::chain
