\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Proposed solution overview: four institutional tiers (T1--T4), six core banking functions, and multi-entity extensions (syndicated lending, group pools, interbank and upward facilities).}}{12}{figure.caption.26}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Capital flow directions: downward tier allocation, same-tier \texttt {InterBankLendingPool} liquidity, and upward \texttt {UpwardDepositFacility} repatriation with asymmetric rates ($r_{\text {up}} < r_{\text {down}}-\delta $).}}{16}{figure.caption.28}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces Methodology phase roadmap: pre-thesis~1 requirements and architecture complete; Phase~I--IV deliverables (contracts, MCP agent, Chainlink Functions, Certora/Foundry simulation).}}{18}{figure.caption.34}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces Stablecoin-first positioning: USDC numeraire, MiCA/GENIUS regulatory anchors, mBridge/Agora settlement rails, and CWB as a composable lending layer.}}{21}{figure.caption.35}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces PRISMA-style literature review flow: identification, screening, included studies, and synthesis themes (hierarchy, ML, inclusion, security).}}{26}{figure.caption.37}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Visual comparison matrix aligned with Table~\ref {tab:protocol-comparison}: institutional hierarchy, cross-tier flows, ML, and inclusion dimensions.}}{39}{figure.caption.49}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Conceptual comparison: opaque centralized reserve reporting versus on-chain Proof of Reserve and tier reserve invariants on CWB.}}{41}{figure.caption.52}%
