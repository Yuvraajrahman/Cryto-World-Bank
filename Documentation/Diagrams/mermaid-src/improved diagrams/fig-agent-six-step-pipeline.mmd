---
title: Optional AI Agent Add-On — Six-Step Pipeline (Phase III–IV)
---
flowchart TB
    classDef step  fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef gate  fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef safe  fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef opt   fill:#FFFFFF,stroke:#1F1F1F,stroke-width:1.2px,color:#111111,stroke-dasharray:5 4

    subgraph INGEST[" Context assembly "]
        direction LR
        S1["SSE message"]:::step
        S2["Inject on-chain JSON"]:::step
        S3{"Intent?"}:::gate
        S1 --> S2 --> S3
    end

    subgraph ROUTE[" Read vs write path "]
        direction LR
        S4["RAG read answer"]:::safe
        S5["Assemble write params"]:::step
        S3 -- Q&A --> S4
        S3 -- Action --> S5
    end

    subgraph EXEC[" Confirmation and audit "]
        direction LR
        S6{"User confirms?"}:::gate
        S7["MCP write + sign"]:::step
        LOG["AGENT_ACTION_LOG"]:::safe
        S5 --> S6 -- Yes --> S7 --> LOG
    end

    OPT["Optional add-on · not MVT"]:::opt --> INGEST
