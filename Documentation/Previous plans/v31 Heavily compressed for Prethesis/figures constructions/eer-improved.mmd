        BR2 --> LR
        LB --> LR
        LR --> AGGBOX
        TX -.-> AGGBOX
        CM -.-> AGGBOX
        ML -.-> AGGBOX
    end

    subgraph PART["Participation constraints"]
        LR2[LOAN_REQUEST]:::strong
        LN2[LOAN]:::strong
        BR3[BORROWER]:::strong
        CP[CREDIT_PASSPORT SBT]:::strong
        LR2 ==>|total 1:1| LN2
        BR3 -->|partial 0:1| CP
    end
