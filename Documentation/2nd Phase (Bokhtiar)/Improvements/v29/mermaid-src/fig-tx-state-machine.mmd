---
title: Loan Lifecycle State Machine — Backend States + Frontend 5-State UX Overlay
---
flowchart TB
    classDef be fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef fe fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef terminal fill:#FFFFFF,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef note fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111,stroke-dasharray:3 3

    subgraph BE[" Backend loan lifecycle (contract + DB) "]
        direction TB
        B0([*]) --> DRAFT
        DRAFT --> PKYC["PENDING_KYC"]
        PKYC -->|fail| REJ["REJECTED"]
        PKYC --> PLIM["PENDING_LIMIT"]
        PLIM -->|fail| REJ
        PLIM --> PSCORE["PENDING_SCORE"]
        PSCORE --> PAPP["PENDING_APPROVAL"]
        PAPP -->|reject| REJ
        PAPP -->|approve + reveal| ACTIVE
        ACTIVE -->|installments| ACTIVE
        ACTIVE --> CLOSED
        ACTIVE --> DEF["DEFAULTED"]
        DEF --> LIQ["LIQUIDATED"]
        DEF -->|cure| ACTIVE
        LIQ --> CLOSED
        CLOSED --> B1([*])
    end

    subgraph FE[" Frontend tx UX overlay (wallet submit) "]
        direction LR
        F0["idle"]:::fe --> F1["pending_signature"]:::fe
        F1 --> F2["submitted"]:::fe
        F2 --> F3["confirming"]:::fe
        F3 --> F4["success"]:::terminal
        F3 --> F5["error"]:::terminal
    end

    MAP["Overlay mapping:<br/>applyLoan / payInstallment / approve<br/>each wallet action runs FE machine<br/>while BE state advances on confirmation"]:::note

    DRAFT -.-> F0
    PAPP -.-> F1
    ACTIVE -.-> F2
    FE -.-> MAP

    ERR["Error taxonomy:<br/>4001 user reject · CALL_EXCEPTION revert · network"]:::note
    F5 -.-> ERR

    class DRAFT,PKYC,PLIM,PSCORE,PAPP,ACTIVE,DEF,LIQ,CLOSED,REJ be
