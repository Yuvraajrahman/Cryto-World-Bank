<mxfile host="app.diagrams.net" modified="2026-06-12" agent="generate-drawio.py" version="22.1.0" type="device">
  <diagram name="0NF Problems" id="nf0">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="n0" value="0NF / Unnormalized (violations to fix)
• Repeating group: multiple income proofs embedded in one BORROWER row
• Repeating group: installment schedule columns duplicated in LOAN
• Transitive dependency: interest-rate parameters stored inside each bank row" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="20" width="700" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="<b>BORROWER (unnormalized)</b><hr size='1'/><div style='text-align:left;font-size:11px;'>borrower_id<br/>wallet<br/>name<br/>income_proof_1_hash, income_proof_2_hash, …  ← repeating<br/>income_proof_1_status, income_proof_2_status, …</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="60" y="180" width="520" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="<b>LOAN (unnormalized)</b><hr size='1'/><div style='text-align:left;font-size:11px;'>loan_id<br/>principal<br/>inst_1_due, inst_1_amount, inst_2_due, inst_2_amount, …  ← repeating</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="60" y="420" width="520" height="76" as="geometry"/>
    </mxCell>
    <mxCell id="e3" value="<b>LOCAL_BANK (unnormalized)</b><hr size='1'/><div style='text-align:left;font-size:11px;'>local_bank_id<br/>name<br/>base_rate, kink_util, rate_above_kink  ← transitive via tier</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="640" y="180" width="480" height="76" as="geometry"/>
    </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="1NF" id="nf1">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="n0" value="1NF — Atomic values; no repeating groups
Fix: extract INCOME_PROOF and INSTALLMENT into separate relations.
Rule: every attribute holds a single atomic value per row." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="20" width="720" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="<b>BORROWER</b><hr size='1'/><div style='text-align:left;font-size:11px;'>borrower_id PK<br/>wallet UK<br/>name<br/>kyc_level</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="60" y="160" width="240" height="92" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="<b>INCOME_PROOF</b><hr size='1'/><div style='text-align:left;font-size:11px;'>proof_id PK<br/>borrower_id FK<br/>file_hash<br/>status<br/>one row per document</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="360" y="160" width="260" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="e3" value="<b>LOAN</b><hr size='1'/><div style='text-align:left;font-size:11px;'>loan_id PK<br/>borrower_id FK<br/>principal<br/>status</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="680" y="160" width="240" height="92" as="geometry"/>
    </mxCell>
    <mxCell id="e4" value="<b>INSTALLMENT</b><hr size='1'/><div style='text-align:left;font-size:11px;'>loan_id FK<br/>installment_number<br/>amount_due<br/>due_date<br/>one row per installment</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="680" y="360" width="260" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="r1" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="e1" target="e2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="r2" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="e3" target="e4">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="n1" value="Functional dependency example:
borrower_id → name, wallet, kyc_level
proof_id → borrower_id, file_hash, status" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="60" y="420" width="560" height="100" as="geometry"/>
    </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2NF" id="nf2">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="n0" value="2NF — No partial dependencies on a composite key
INSTALLMENT composite PK: (loan_id, installment_number)
All non-key attributes must depend on the FULL key, not just loan_id." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="20" width="760" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="<b>LOAN</b><hr size='1'/><div style='text-align:left;font-size:11px;'>loan_id PK<br/>borrower_id FK<br/>principal<br/>apr_bps<br/>term_months</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="80" y="180" width="300" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="<b>INSTALLMENT ✓ 2NF</b><hr size='1'/><div style='text-align:left;font-size:11px;'>PK: (loan_id, installment_number)<br/>amount_due → full key<br/>due_date → full key<br/>NOT: borrower_name → loan_id only ✗</div>" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="460" y="180" width="320" height="92" as="geometry"/>
    </mxCell>
    <mxCell id="e3" value="<b>VIOLATION example (remove this)</b><hr size='1'/><div style='text-align:left;font-size:11px;'>PK: (loan_id, installment_number)<br/>borrower_wallet → depends only on loan_id ✗ partial<br/>local_bank_city → depends only on loan_id ✗ partial</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="80" y="420" width="360" height="76" as="geometry"/>
    </mxCell>
    <mxCell id="e4" value="<b>2NF fix</b><hr size='1'/><div style='text-align:left;font-size:11px;'>Move borrower_wallet to LOAN or BORROWER<br/>Move local_bank_city to LOCAL_BANK<br/>Keep only installment-specific attrs on INSTALLMENT</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="500" y="420" width="360" height="76" as="geometry"/>
    </mxCell>
    <mxCell id="r1" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="e1" target="e2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3NF" id="nf3">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
    <mxCell id="n0" value="3NF — No transitive dependencies
Violation: bank_tier → rate parameters stored inside bank rows
Fix: INTEREST_RATE_TIER(tier_id) referenced by bank entities." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="20" width="780" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="e1" value="<b>BEFORE (not 3NF)</b><hr size='1'/><div style='text-align:left;font-size:11px;'>local_bank_id → name, city<br/>local_bank_id → base_rate, kink_util  ✗ transitive<br/>(tier determines rates, not local_bank_id directly)</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="60" y="180" width="340" height="76" as="geometry"/>
    </mxCell>
    <mxCell id="e2" value="<b>INTEREST_RATE_TIER</b><hr size='1'/><div style='text-align:left;font-size:11px;'>tier_id PK<br/>base_rate<br/>kink_utilisation<br/>rate_above_kink<br/>max_rate</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="460" y="180" width="280" height="108" as="geometry"/>
    </mxCell>
    <mxCell id="e3" value="<b>WORLD_BANK</b><hr size='1'/><div style='text-align:left;font-size:11px;'>world_bank_id PK<br/>interest_rate_tier_id FK</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="60" y="420" width="300" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="e4" value="<b>NATIONAL_BANK</b><hr size='1'/><div style='text-align:left;font-size:11px;'>national_bank_id PK<br/>interest_rate_tier_id FK</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="400" y="420" width="300" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="e5" value="<b>LOCAL_BANK</b><hr size='1'/><div style='text-align:left;font-size:11px;'>local_bank_id PK<br/>interest_rate_tier_id FK</div>" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="740" y="420" width="280" height="72" as="geometry"/>
    </mxCell>
    <mxCell id="r1" value="FK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="e2" target="e3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="r2" value="FK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="e2" target="e4">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="r3" value="FK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;endFill=0;startFill=0;" edge="1" parent="1" source="e2" target="e5">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="n1" value="Additional 3NF rules in CWB schema:
• BORROWING_LIMIT.six_month_remaining derived from TRANSACTION — store limit_id→borrower_id only; compute at query time
• BCNF: BANK_USER bank_type CHECK — determinant is candidate key" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
