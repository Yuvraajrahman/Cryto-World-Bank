// Phase I (Gate G1) — 13 M1 tables per thesis Ch. 3 Table db-implementation-tiers.
// Legacy chat/income models remain for the existing API until Phase II migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstitutionType {
  WORLD
  NATIONAL
  LOCAL
}

enum BankUserRole {
  WORLD_BANK_ADMIN
  NATIONAL_BANK_ADMIN
  LOCAL_BANK_ADMIN
  APPROVER
}

enum KycLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum LoanRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  CANCELLED
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  REPAID
  DEFAULTED
}

enum AssetSymbol {
  ETH
  MUSDC
}

// ---- M1 core (Phase I) ----

model Country {
  countryCode   String        @id @db.VarChar(3)
  name          String
  institutions  Institution[]
  createdAt     DateTime      @default(now())
}

model Institution {
  id              String           @id @default(cuid())
  institutionType InstitutionType
  name            String
  onChainAddress  String?          @unique
  countryCode     String?
  country         Country?         @relation(fields: [countryCode], references: [countryCode])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  worldBank       WorldBank?
  nationalBank    NationalBank?
  localBank       LocalBank?
  bankUsers       BankUser[]
  borrowers       Borrower[]
  loanRequests    LoanRequest[]
  loans           Loan[]
  assets          Asset[]
  capital         InstitutionCapital?

  @@index([institutionType])
}

model WorldBank {
  institutionId String      @id
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  lendingAprBps Int         @default(300)
}

model NationalBank {
  institutionId     String      @id
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  parentWorldBankId String
  lendingAprBps     Int         @default(500)
  jurisdiction      String?
}

model LocalBank {
  institutionId        String      @id
  institution          Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  parentNationalBankId String
  borrowAprBps         Int         @default(800)
  region               String?
}

model BankUser {
  id            String       @id @default(cuid())
  institutionId String
  institution   Institution  @relation(fields: [institutionId], references: [id])
  walletAddress String       @unique
  displayName   String?
  role          BankUserRole
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Borrower {
  id                     String        @id @default(cuid())
  walletAddress          String        @unique
  registeredLocalBankId  String
  localBank              Institution   @relation(fields: [registeredLocalBankId], references: [id])
  kycLevel               KycLevel      @default(LEVEL_0)
  kycDocumentHash        String?
  kycVerifiedAt          DateTime?
  kycExpiry              DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  loanRequests LoanRequest[]
  loans        Loan[]
  creditPassport CreditPassportRecord?
  borrowingLimit BorrowingLimit?
  incomeProofs IncomeProof[]
}

model LoanRequest {
  id              String            @id @default(cuid())
  borrowerId      String
  borrower        Borrower            @relation(fields: [borrowerId], references: [id])
  localBankId     String
  localBank       Institution         @relation(fields: [localBankId], references: [id])
  principalWei    String
  termMonths      Int
  purpose         String?
  docHash         String?
  nidDocHash      String?
  photoDocHash    String?
  status          LoanRequestStatus   @default(DRAFT)
  onChainRequestId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  loan Loan?
}

// ---- M2 (Phase II) ----

enum RiskTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model CreditPassportRecord {
  id               String   @id @default(cuid())
  borrowerId       String   @unique
  borrower         Borrower @relation(fields: [borrowerId], references: [id])
  creditScore      Int      @default(300)
  riskTier         RiskTier @default(SILVER)
  openLoans        Int      @default(0)
  completedCycles  Int      @default(0)
  onChainAddress   String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model BorrowingLimit {
  id            String   @id @default(cuid())
  borrowerId    String   @unique
  borrower      Borrower @relation(fields: [borrowerId], references: [id])
  maxPrincipalWei String
  windowMonths  Int      @default(6)
  usedWei       String   @default("0")
  updatedAt     DateTime @updatedAt
}

model IncomeProof {
  id           String             @id @default(cuid())
  borrowerId   String
  borrower     Borrower           @relation(fields: [borrowerId], references: [id])
  documentHash String
  monthlyUsd   Float?
  status       VerificationStatus @default(PENDING)
  reviewedBy   String?
  createdAt    DateTime           @default(now())
}

model InterestRateTier {
  id        String   @id @default(cuid())
  tierName  String
  minScore  Int
  maxScore  Int
  aprBps    Int
  createdAt DateTime @default(now())
}

model LoanGroup {
  id              String   @id @default(cuid())
  name            String   @default("Unnamed group")
  inviteCode      String   @unique
  organizerUserId String?
  localBankId     String
  onChainId       String?
  status          String   @default("FORMING") // FORMING | ACTIVE | CLOSED
  minMembers      Int      @default(3)
  maxMembers      Int      @default(20)
  termsJson       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  members         GroupMember[]
  loanRequests    GroupLoanRequest[]

  @@index([organizerUserId])
  @@index([status])
}

model GroupMember {
  id            String    @id @default(cuid())
  groupId       String
  group         LoanGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Legacy chain projection field (Borrower.id); prefer userId for retail API
  borrowerId    String    @default("")
  userId        String?
  walletAddress String?
  role          String    @default("MEMBER") // ORGANIZER | MEMBER
  consented     Boolean   @default(false)
  joinedAt      DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([walletAddress])
  @@index([userId])
}

model GroupLoanRequest {
  id             String   @id @default(cuid())
  groupId        String
  group          LoanGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requestedBy    String
  totalAmountEth Float
  termMonths     Int
  purpose        String
  status         String   @default("AWAITING_CONSENT") // DRAFT | AWAITING_CONSENT | ACTIVE | CANCELLED | REJECTED
  retailLoanId   String?  // optional link into JSON demo loan store
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  activatedAt    DateTime?
  consents       GroupLoanConsent[]

  @@index([groupId, status])
}

model GroupLoanConsent {
  id          String           @id @default(cuid())
  requestId   String
  request     GroupLoanRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId      String
  consentedAt DateTime?
  signature   String?
  declinedAt  DateTime?

  @@unique([requestId, userId])
  @@index([userId])
}

model UpwardDepositRecord {
  id            String   @id @default(cuid())
  depositorId   String
  parentId      String
  amountWei     String
  onChainTxHash String?
  createdAt     DateTime @default(now())
}

model InterbankLoanRecord {
  id            String   @id @default(cuid())
  lenderId      String
  borrowerId    String
  principalWei  String
  tenorDays     Int
  status        String   @default("ACTIVE")
  onChainLoanId String?
  createdAt     DateTime @default(now())
}

model SavingsAccount {
  id            String   @id @default(cuid())
  borrowerId    String
  vaultAddress  String
  sharesWei     String   @default("0")
  createdAt     DateTime @default(now())
}

model AgentSession {
  id        String   @id @default(cuid())
  wallet    String
  startedAt DateTime @default(now())
  endedAt   DateTime?
  turns     AgentActionLog[]
}

model AgentActionLog {
  id        String       @id @default(cuid())
  sessionId String
  session   AgentSession @relation(fields: [sessionId], references: [id])
  toolName  String
  payload   Json?
  confirmed Boolean      @default(false)
  createdAt DateTime     @default(now())
}

model Loan {
  id            String     @id @default(cuid())
  requestId     String     @unique
  request       LoanRequest @relation(fields: [requestId], references: [id])
  borrowerId    String
  borrower      Borrower   @relation(fields: [borrowerId], references: [id])
  localBankId   String
  localBank     Institution @relation(fields: [localBankId], references: [id])
  onChainLoanId String?    @unique
  principalWei  String
  aprBps        Int
  termMonths    Int
  status        LoanStatus @default(PENDING)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  installments Installment[]
}

model Installment {
  id         String    @id @default(cuid())
  loanId     String
  loan       Loan      @relation(fields: [loanId], references: [id])
  index      Int
  amountWei  String
  dueDate    DateTime
  paid       Boolean   @default(false)
  paidAt     DateTime?
  txHash     String?

  @@unique([loanId, index])
}

model BlockchainEventLog {
  id          String   @id @default(cuid())
  contract    String
  eventName   String
  txHash      String
  blockNumber Int
  logIndex    Int
  payload     Json
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([contract, eventName])
  @@map("BLOCKCHAIN_EVENT_LOG")
}

model Asset {
  id            String      @id @default(cuid())
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  symbol        AssetSymbol
  contractAddress String?
  decimals      Int         @default(18)
  createdAt     DateTime    @default(now())

  @@index([symbol])
}

model AuditLog {
  id         String   @id @default(cuid())
  eventType  String
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorType  String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([eventType])
  @@map("AUDIT_LOGS")
}

// ---- Legacy API models (Phase II migration) ----

enum UserRole {
  OWNER
  NATIONAL_BANK_ADMIN
  LOCAL_BANK_ADMIN
  APPROVER
  BORROWER
  REGULATOR
  DEV_ADMIN // Permanent Super Admin — full platform access
}

enum VerificationStatus {
  UNSUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum AccountIntent {
  individual
  group
}

enum KycSubmissionStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String              @id @default(cuid())
  wallet               String              @unique
  /// Stable User ID for password login (e.g. client_brazil_rio_00001, bangladesh, local_bangladesh_dhaka)
  loginId              String?             @unique
  displayName          String?
  email                String?             @unique
  emailConfirmed       Boolean             @default(false)
  pendingEmail         String?
  emailConfirmToken    String?
  passwordHash         String?
  phone                String?
  country              String?
  dateOfBirth          DateTime?           @db.Date
  accountType          AccountIntent       @default(individual)
  role                 UserRole            @default(BORROWER)
  bankId               String?
  isFirstTime          Boolean             @default(true)
  onboardingComplete   Boolean             @default(false)
  consecutivePaidLoans Int                 @default(0)
  totalBorrowedLifetime Float              @default(0)
  monthlyIncomeUsd     Float?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  kyc1Status           KycSubmissionStatus @default(NOT_STARTED)
  kyc1IdFrontName      String?
  kyc1IdBackName       String?
  kyc1SelfieName       String?
  kyc1DocHash          String?
  kyc1SubmittedAt      DateTime?
  kyc1RejectionReason  String?

  kyc2Status           KycSubmissionStatus @default(NOT_STARTED)
  kyc2Skipped          Boolean             @default(false)
  kyc2AddressDocName   String?
  kyc2IncomeDocName    String?
  kyc2DocHash          String?
  kyc2SubmittedAt      DateTime?
  kyc2RejectionReason  String?

  consentRisk          Boolean?
  consentData          Boolean?
  consentAgent         Boolean?
  consentedAt          DateTime?

  /// Channel + category toggles for Settings (Section C).
  notificationPrefs    Json?

  incomeVerification IncomeVerification?
  messagesSent       ChatMessage[]        @relation("SentMessages")
  messagesReceived   ChatMessage[]        @relation("ReceivedMessages")
  auditEvents        AuditLog[]
  notifications      Notification[]

  @@index([role])
  @@index([onboardingComplete])
}

enum NotificationCategory {
  loan
  kyc
  payment
  agent
  chat
  system
  aml
  capital
  governance
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory @default(system)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Off-chain projection of per-institution capital (FR-07 read model).
/// Authoritative balances remain on-chain; this table powers dashboards.
model InstitutionCapital {
  id              String      @id @default(cuid())
  institutionId   String      @unique
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  /// Reserve held at this tier (ETH units as float for demo dashboards; wei string optional)
  reserveEth      Float       @default(0)
  allocatedEth    Float       @default(0)
  lentEth         Float       @default(0)
  repaidEth       Float       @default(0)
  insuranceEth    Float       @default(0)
  activeLoanCount Int         @default(0)
  syncedAt        DateTime    @default(now())
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([syncedAt])
}

model IncomeVerification {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id])
  documentUrl String?
  monthlyUsd  Float?
  status      VerificationStatus @default(UNSUBMITTED)
  reviewedBy  String?
  reviewedAt  DateTime?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model ChatThread {
  id        String        @id @default(cuid())
  subject   String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id])
  senderId   String
  sender     User       @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User       @relation("ReceivedMessages", fields: [receiverId], references: [id])
  body       String
  createdAt  DateTime   @default(now())
}

// ---- Phase 2 economy simulation (Neon — survives Vercel cold starts) ----

model SimulationConfig {
  id                String   @id @default("default")
  baseRateBps       Int      @default(300)
  slope1Bps         Int      @default(500)
  slope2Bps         Int      @default(7500)
  kinkBps           Int      @default(8000)
  minReserveRatio   Float    @default(0.15)
  tierModifiersJson Json?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  history           SimulationConfigHistory[]
}

model SimulationConfigHistory {
  id        String           @id @default(cuid())
  configId  String           @default("default")
  config    SimulationConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  field     String
  fromValue Json
  toValue   Json
  changedBy String?
  note      String?
  createdAt DateTime         @default(now())

  @@index([configId, createdAt])
}

model SimulationRun {
  id                      String    @id @default(cuid())
  seed                    Int
  totalCapitalUsdc        Float
  clientMultiplier        Float     @default(1)
  simulatedDays           Int       @default(365)
  sampleNationals         Int
  sampleLocalsPerNational Int
  clientsPerLocal           Int
  status                  String    @default("COMPLETED")
  summaryJson             Json?
  verificationJson        Json?
  configSnapshotJson      Json?
  triggeredBy             String?
  startedAt               DateTime  @default(now())
  completedAt             DateTime?

  @@index([startedAt])
}
