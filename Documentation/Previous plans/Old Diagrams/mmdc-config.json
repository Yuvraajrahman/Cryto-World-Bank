  "themeCSS": ".label, .nodeLabel, .edgeLabel, .actor, text, .messageText, .loopText, .noteText, .labelText, tspan, foreignObject div, foreignObject span { font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif !important; font-size: 20px !important; font-weight: 500 !important; line-height: 1.3 !important; } .cluster-label { font-size: 18px !important; font-weight: 600 !important; } .edgePath .path, .flowchart-link, .messageLine0, .messageLine1, .relationshipLine, .relationshipLabelBox text { stroke: #1F1F1F !important; }",
