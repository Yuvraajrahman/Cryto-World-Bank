---
title: Client Banking Session — Chat, Dashboard, and Optional Agent
---
flowchart LR
    classDef start  fill:#1F1F1F,color:#FFFFFF,stroke:#1F1F1F,stroke-width:2.5px
    classDef finish fill:#FFFFFF,color:#111111,stroke:#1F1F1F,stroke-width:2.5px
    classDef act    fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef dec    fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.6px,color:#111111
    classDef core   fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.6px,color:#111111
    classDef opt    fill:#FFFFFF,stroke:#1F1F1F,stroke-width:1.4px,color:#111111,stroke-dasharray:6 4
    classDef gate   fill:#E8E8E8,stroke:#1F1F1F,stroke-width:1.4px,color:#111111

    S(("Start")):::start

    subgraph PRE[" Session bootstrap "]
        direction TB
        PRE1["Client authenticates<br/>JWT + wallet context"]:::act
        PRE2["Prefetch Chainlink fiat/USD<br/>10s cache for loan form"]:::act
        PRE1 --> PRE2
    end

    PRE --> ROUTE{Client<br/>channel?}:::dec

    subgraph DASH[" Primary — React dashboard "]
        direction TB
        D1["Direct REST / EIP-712 call<br/>loan · repay · savings"]:::act
        D2["Express validates + routes<br/>to smart contract"]:::act
        D1 --> D2
    end

    subgraph CHAT[" Human support chat "]
        direction TB
        C1["Open WebSocket thread<br/>bank officer queue"]:::act
        C2["Persist CHAT_MESSAGE<br/>off-chain PostgreSQL"]:::act
        C1 --> C2
    end

    subgraph AGENT[" Optional agent add-on "]
        direction TB
        AG0["Phase III–IV · not MVT"]:::opt
        AG1["Inject on-chain context<br/>loans · SBT · installments"]:::act
        AG2{Write tool<br/>requested?}:::dec
        AG3["RAG read-only<br/>answer"]:::act
        AG4["Show confirmation<br/>summary"]:::gate
        AG5{Explicit<br/>Yes?}:::dec
        AG6["MCP write<br/>EIP-7702 sign<br/>403 if no confirm"]:::act
        AG0 --> AG1 --> AG2
        AG2 -- "No" --> AG3
        AG2 -- "Yes" --> AG4 --> AG5
        AG5 -- "Yes" --> AG6
    end

    subgraph FIN[" Audit & close "]
        direction TB
        F1["Log action + correlation ID<br/>AGENT_ACTION_LOG if agent"]:::act
        F2["Return result<br/>to client UI"]:::act
        F1 --> F2
    end

    E(("End")):::finish

    ROUTE -- "Dashboard" --> DASH --> FIN
    ROUTE -- "Live chat" --> CHAT --> FIN
    ROUTE -- "Agent UI" --> AGENT
    AG3 --> FIN
    AG5 -- "No" --> FIN
    AG6 --> FIN
    FIN --> E
