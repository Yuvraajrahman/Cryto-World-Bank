flowchart TB
    classDef contract fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef step fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef tier fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111
