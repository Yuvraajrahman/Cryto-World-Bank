---
title: AI / ML Pipeline - Training, Oracle, GNN, Federated Learning
---
flowchart TB
    classDef step fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef store fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef chain fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111

    subgraph A[" Training pipeline "]
        direction LR
        DS[("Loan history")]:::store
        FE["Feature engineering"]:::step
        RF["Random Forest"]:::step
        IF["Isolation Forest"]:::step
        SH["SHAP explainability"]:::step
        REG["Model registry"]:::store
        DS --> FE --> RF & IF --> SH --> REG
    end

    subgraph B[" Commit-reveal oracle "]
        direction LR
        ML["FastAPI service"]:::step
        CM["commit(hash)"]:::chain
        RV["reveal(score, salt)"]:::chain
        OUT["LoanApproved event"]:::chain
        REG --> ML --> CM --> RV --> OUT
    end

    subgraph C[" GNN extension "]
        direction LR
        GR[("Wallet graph")]:::store
        GNN["GraphSAGE"]:::step
        RF2["Augment RF features"]:::step
        GR --> GNN --> RF2 --> REG
    end

    subgraph D[" Federated learning "]
        direction LR
        LB["LB local trainers"]:::step
        AGG["NB aggregator"]:::step
        GLOB["Global fraud model"]:::chain
        LB --> AGG --> GLOB
    end

    A --> B
    C -.-> A
    D -.-> A
