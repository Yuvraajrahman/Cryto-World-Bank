\contentsline {figure}{\numberline {5.2}{\ignorespaces Hierarchical interest-rate spread (APR) across the four-tier lending structure.}}{168}{figure.caption.245}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces MiCA and GENIUS Act compliance mapping: EMT requirements to CWB stablecoin pools, Chainlink Proof of Reserve, and \texttt {audit\_logs}.}}{171}{figure.caption.249}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Accessibility journey (rural Sylhet use case): mobile access $\to $ Bengali-capable agent $\to $ USDC-denominated loan $\to $ human confirmation gate.}}{174}{figure.caption.255}%
