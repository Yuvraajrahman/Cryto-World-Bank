---
title: On-Chain vs Off-Chain Data Partitioning
---
flowchart TB
    classDef on  fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef off fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef hyb fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.2px,color:#111111

    subgraph ON[" On-chain "]
        direction LR
        O1["Reserve balances"]:::on
        O2["Loan state"]:::on
        O3["RBAC · SBT"]:::on
    end

    subgraph OFF[" Off-chain "]
        direction LR
        F1["KYC documents"]:::off
        F2["ML · chat logs"]:::off
        F3["Session cache"]:::off
    end

    subgraph HYB[" Hybrid limits "]
        direction LR
        H1["Compute off-chain"]:::hyb
        H2["Enforce on-chain"]:::hyb
        H1 --> H2
    end

    ON --> OFF --> HYB
