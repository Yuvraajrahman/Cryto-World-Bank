%%{init: {"theme": "base", "flowchart": {"htmlLabels": true, "curve": "linear", "nodeSpacing": 18, "rankSpacing": 22, "padding": 6, "useMaxWidth": false}, "themeVariables": {"fontSize": "13px"}} }%%
flowchart TB

  subgraph BACK["Tier backbone"]
    direction LR
    WB["World Bank<br/>(Tier 1)"]
    NB["National Bank<br/>(Tier 2)"]
    LB["Local Bank<br/>(Tier 3)"]
    CL["Client<br/>(Tier 4)"]
    WB ==>|"allocate"| NB
    NB ==>|"allocate"| LB
    LB ==>|"loan"| CL
    CL -.->|"repay"| LB
    LB -.->|"surplus"| NB
    NB -.->|"surplus"| WB
  end

  subgraph ROW1[" "]
    direction LR
    subgraph OP1["1. InterBankLendingPool &mdash; same-tier liquidity (1/7/30-day)"]
      direction TB
      NBa["National Bank A"] <-->|"IBLP_NB"| NBb["National Bank B"]
      LBa["Local Bank A"] <-->|"IBLP_LB"| LBb["Local Bank B"]
      NBa ~~~ LBa
    end
    subgraph OP2["2. UpwardDepositFacility &mdash; surplus repatriation"]
      direction TB
      LBu["Local Bank (surplus)"] -.->|"deposit"| NBu["National Bank"]
      NBu -.->|"deposit"| WBu["World Bank"]
    end
    OP1 ~~~ OP2
  end

  subgraph ROW2[" "]
    direction LR
    subgraph OP3["3. SyndicatedLoan &mdash; single-name exposure &gt; ceiling"]
      direction TB
      LEAD["Lead Arranger (LB)"]
      CO1["Co-Lender 1"]
      CO2["Co-Lender 2"]
      SBORR["Borrower (via LB)"]
      LEAD ~~~ CO1 ~~~ CO2
      LEAD -->|"&ge; 90% commit"| SBORR
      CO1 -->|"pro-rata"| SBORR
      CO2 -->|"pro-rata"| SBORR
    end
    subgraph OP4["4. TranchedPool &mdash; senior / junior waterfall"]
      direction TB
      SEN["Senior (protected)"]
      JUN["Junior (first-loss)"]
      POOL["TranchedPool"]
      TBORR["Borrower"]
      SEN --> POOL
      JUN --> POOL
      POOL -->|"waterfall"| TBORR
    end
    OP3 ~~~ OP4
  end

  subgraph ROW3[" "]
    direction LR
    subgraph OP5["5. TreasurySwap &mdash; oracle-priced, atomic"]
      BW1["Bank wallet (asset A)"] <-->|"Chainlink, 5-10 bps"| BW2["Bank wallet (asset B)"]
    end
    NETT["6. Multilateral NettingEngine (Future Work):<br/>batch settlement of IBLP + TreasurySwap obligations"]
    OP5 ~~~ NETT
  end

  BACK ~~~ ROW1
  ROW1 ~~~ ROW2
  ROW2 ~~~ ROW3

  classDef apex fill:#D6E4F7,stroke:#1B1B1B,stroke-width:1.2px,color:#111111;
  classDef mid fill:#EAF1FB,stroke:#1B1B1B,stroke-width:1.1px,color:#111111;
  classDef leaf fill:#FFFFFF,stroke:#1B1B1B,stroke-width:1.1px,color:#111111;
  classDef note fill:#F2F4F7,stroke:#8A8A8A,stroke-width:1px,color:#111111;
  class WB,WBu apex;
  class NB,LB,NBa,NBb,LBa,LBb,LBu,NBu,LEAD,CO1,CO2,SBORR,SEN,JUN,POOL,TBORR,BW1,BW2 mid;
  class CL leaf;
  class NETT note;
