# =========================================================
# Crypto World Bank — environment variable template
# Copy to .env and fill in values. NEVER commit real secrets.
# =========================================================

# ---- Smart contract deployment ----
# Option A (recommended for multi-persona UI): Hardhat test mnemonic — fund accounts 0–5 on Sepolia
SEPOLIA_MNEMONIC=
# Option B: single deployer key (all personas fall back to same wallet)
PRIVATE_KEY=
# Optional: separate keys for personas 1–5 when using PRIVATE_KEY for account #0
SEPOLIA_ACCOUNT_1_PRIVATE_KEY=
SEPOLIA_ACCOUNT_2_PRIVATE_KEY=
SEPOLIA_ACCOUNT_3_PRIVATE_KEY=
SEPOLIA_ACCOUNT_4_PRIVATE_KEY=
SEPOLIA_ACCOUNT_5_PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ETH seeded into World Bank reserve on deploy (default 0.5 on testnets)
SEED_RESERVE_ETH=0.5
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# ---- Frontend (copy to frontend/.env) ----
VITE_WALLETCONNECT_PROJECT_ID=
VITE_WORLD_BANK_ADDRESS=
VITE_NATIONAL_BANK_ADDRESS=
VITE_LOCAL_BANK_ADDRESS=
VITE_MOCK_USDC_ADDRESS=
VITE_CHAIN_ID=11155111
VITE_API_BASE_URL=http://localhost:4000
VITE_ML_BASE_URL=http://localhost:8000

# ---- Backend (copy to backend/.env) ----
PORT=4000
DATABASE_URL=postgresql://cwb:cwb@localhost:5432/crypto_world_bank
JWT_SECRET=change_me_in_production
CORS_ORIGIN=http://localhost:5173
CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
WORLD_BANK_ADDRESS=
NATIONAL_BANK_ADDRESS=
LOCAL_BANK_ADDRESS=
MOCK_USDC_ADDRESS=
ML_SERVICE_URL=http://localhost:8000

# ---- ML service (copy to ml-service/.env) ----
ML_PORT=8000
