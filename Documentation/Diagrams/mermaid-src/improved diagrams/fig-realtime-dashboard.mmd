---
title: Real-Time Dashboard and Runtime Monitoring Pipeline
---
flowchart LR
    classDef chain fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef step  fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef store fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef view  fill:#FFFFFF,stroke:#1F1F1F,stroke-width:1.6px,color:#111111

    subgraph LEFT[" Ingestion & indexing "]
        direction TB
        SC["Smart contracts<br/>emit typed events"]:::chain
        GRP["The Graph subgraph<br/>(indexer)"]:::step
        TEN["Tenderly<br/>(runtime alerts)"]:::step
        SC --> GRP
        SC --> TEN
    end

    subgraph MID[" Processing & detection "]
        direction TB
        WS["WebSocket server<br/>(Node 20)"]:::step
        ANL["Anomaly detector<br/>(Isolation Forest)"]:::step
        OPS["Ops runbook +<br/>function pause"]:::store
        GRP --> WS
        GRP --> ANL
        TEN -. "incident webhook" .-> OPS
        ANL -. "alert" .-> OPS
    end

    subgraph RIGHT[" Consumer views "]
        direction TB
        CACHE[("Redis cache<br/>latest snapshot")]:::store
        DASH["React dashboard<br/>charts + alerts"]:::view
        REG["Read-only<br/>regulator view"]:::view
        WS --> CACHE --> DASH --> REG
    end

    LEFT --> MID --> RIGHT
