---
title: Compliance and Identity Stack — zkKYC, zkAML, KYC Ladder, ERC-4337
---
flowchart TB
    classDef actor fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef proc  fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef store fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef chain fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef plan  fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111,stroke-dasharray:4 4

    subgraph A[" (a) zkKYC + Groth16 + DID / VC "]
        direction LR
        U1(("User")):::actor --> ID["zkKYC Provider<br/>(Polygon ID · Onfido)"]:::proc
        ID --> VC["Verifiable Credential<br/>signed by issuer"]:::store
        VC --> G16["Groth16 KYCVerifier<br/>(Circom 2.0 · Cardona)"]:::chain
        G16 --> SC1["LocalBank<br/>kycVerified[wallet]"]:::chain
    end

    subgraph B[" (b) zkAML continuous monitoring [planned] "]
        direction LR
        TX["On-chain tx"] --> AML["zkAML circuit<br/>(sanction-list match)"]:::plan
        AML -- "non-membership proof" --> AT["Attestation event<br/>amlClean(txHash)"]:::chain
        AML -- "match" --> FLAG["Compliance alert +<br/>functionPaused"]:::store
    end

    subgraph C[" (c) Tiered KYC ladder — USDC limits "]
        direction TB
        L0["L0 Unverified<br/>view only"]:::chain --> L1["L1 Basic · NID + selfie<br/>≤ 250 USDC"]:::chain
        L1 --> L2["L2 Standard · income proof<br/>≤ 5,000 USDC"]:::chain
        L2 --> L3["L3 Enhanced · full docs<br/>≤ 25,000 USDC"]:::chain
        L3 --> L4["L4 Entity + SoF<br/>institutional band"]:::chain
    end

    subgraph D[" (d) ERC-4337 AA · Paymaster bootstrap "]
        direction LR
        U2(("Non-crypto user")):::actor --> WAL["Smart-account wallet<br/>(passkey / social)"]:::proc
        WAL --> BUN["Bundler / Paymaster<br/>pre-KYC: 2 txs cap"]:::proc
        BUN --> EP["EntryPoint v0.7"]:::chain
        EP --> SC2["submitKYCHash +<br/>account creation only"]:::chain
        SC2 -. "post-KYC: full sponsorship" .-> PM["Paymaster budget<br/>per verified identity"]:::store
    end
