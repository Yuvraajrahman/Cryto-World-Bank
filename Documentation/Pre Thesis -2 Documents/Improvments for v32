    net_settlements     JSONB,  -- the reduced settlement instructions
    challenge_deadline  TIMESTAMPTZ,
    on_chain_batch_id   BIGINT,
    settlement_tx_hash  VARCHAR(66),
    settled_at          TIMESTAMPTZ,
    event_log_id        UUID REFERENCES blockchain_event_log(event_id)
);
```

