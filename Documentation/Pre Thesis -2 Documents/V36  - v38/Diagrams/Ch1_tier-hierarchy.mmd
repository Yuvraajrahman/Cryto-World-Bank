flowchart TB
  WB["<b>World Bank Reserve</b><br/>Apex liquidity &amp; reserve rules"]
  NB["<b>National Bank</b><br/>Regional capital allocation"]
  LB["<b>Local Bank / MFI</b><br/>Retail &amp; group lending"]
  CL["<b>Client</b><br/>Individuals &amp; solidarity groups"]

  WB ==>|capital| NB
  NB ==>|capital| LB
