---
title: Client Entry, KYC Limits, and Bank-Level Syndication (USDC-first)
---
flowchart TB
    classDef entry fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef sbt  fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef rule fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef bank fill:#E8E8E8,stroke:#1F1F1F,stroke-width:1.2px,color:#111111

    subgraph ENTRY[" Client entry (Tier 4) "]
        direction LR
        C["All end clients apply<br/>through Local Bank only"]:::entry
    end

    subgraph KYC[" Risk-based KYC ladder "]
        direction LR
        L0["L0 View only"]:::rule --> L1["L1 Basic cap"]:::rule --> L2["L2 Standard cap"]:::rule --> L3["L3 Enhanced cap"]:::rule
    end

    subgraph SBT[" Credit Passport tiers "]
        direction LR
        B["Bronze"]:::sbt --> S["Silver"]:::sbt --> G["Gold"]:::sbt --> P["Platinum"]:::sbt --> D["Diamond"]:::sbt
    end

    subgraph RULES[" On-chain enforcement "]
        direction LR
        R1["kycLevel caps loan"]:::rule
        R2["SBT openLoans cap"]:::rule
        R3["USDC at Tier 4"]:::rule
    end

    subgraph SYND[" Large exposure (bank tier) "]
        direction LR
        SL["SyndicatedLoan<br/>Lead Arranger + Co-Lenders"]:::bank
    end

    ENTRY --> KYC
    KYC --> SBT
    ENTRY -.-> RULES
    SL -.->|"when bank exposure<br/>exceeds ceiling"| ENTRY
