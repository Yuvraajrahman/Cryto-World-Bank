  classDef mid  fill:#eef2f7,stroke:#1b1b1b,stroke-width:1.1px,color:#111111;
  classDef leaf fill:#ffffff,stroke:#1b1b1b,stroke-width:1.1px,color:#111111;
  class WB apex;
  class NB mid;
  class LB mid;
  class CL leaf;
