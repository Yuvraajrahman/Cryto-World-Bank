    NATIONAL_BANK ||--o{ UPWARD_DEPOSIT : receives_surplus

    NATIONAL_BANK ||--o{ SYNDICATE : lead_arranges
    SYNDICATE ||--o{ SYNDICATE_MEMBER : has_member
    LOCAL_BANK ||--o{ SYNDICATE_MEMBER : subscribes
