  "themeCSS": ".label, .nodeLabel, .edgeLabel, .actor, text, .messageText, .loopText, .noteText, .labelText, tspan { font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif !important; font-weight: 500; } .edgePath .path, .flowchart-link, .messageLine0, .messageLine1, .relationshipLine, .relationshipLabelBox text { stroke: #1F1F1F !important; } .node rect, .node polygon, .node circle, .node ellipse, .node path, .cluster rect, .actor { stroke: #1F1F1F !important; stroke-width: 1.2px !important; }",
