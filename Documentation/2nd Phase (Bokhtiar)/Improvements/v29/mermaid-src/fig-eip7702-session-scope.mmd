---
title: EIP-7702 Session Key — JSON Scope, 500 USDC Cap, 24h TTL, Revocation
---
flowchart TB
    classDef client fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef store fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef key  fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef enforce fill:#FFFFFF,stroke:#1F1F1F,stroke-width:1.4px,color:#111111

    LOGIN["Client login · wallet sign<br/>EIP-712 JWT issued"]:::client
    LOGIN --> AUTH["Authorise EIP-7702 session key"]:::client

    subgraph SCOPE[" session_key_scope (JSONB in SESSIONS) "]
        direction TB
        J["session_key_scope JSONB<br/>approved_tools: submit_loan_application, pay_installment<br/>value_cap_usdc: 500 · ttl_hours: 24 · revoked: false"]:::store
    end

    AUTH --> J
    J --> DB[("PostgreSQL SESSIONS<br/>session_key_hash · expires_at")]:::store

    subgraph C[" Four hard constraints "]
        C1["(1) Scope — named MCP write tools only"]:::key
        C2["(2) Time-bound — 24h TTL auto-expire"]:::key
        C3["(3) Value-capped — ≤ 500 USDC / tx"]:::key
        C4["(4) Revocable — client UI invalidate"]:::key
    end

    J --> C

    WRITE["Agent write tool POST<br/>after confirmation gate"]:::client
    WRITE --> H2["Hook 2 · scope pre-check<br/>(Phase III)"]:::enforce
    H2 --> SIGN["Session key signs tx<br/>on-chain scope enforcement"]:::enforce
    SIGN --> LOG["AGENT_ACTION_LOG<br/>confirmation_turn_id · tx_hash"]:::store

    REV["Client revoke session<br/>revoked=true · key invalidated"]:::client
    REV -.-> DB
    REV -.-> C4

    DENY["Rejected: external transfer ·<br/>out-of-scope tool · over cap · expired"]:::enforce
    H2 -.->|fail| DENY
