---
title: Chainlink Oracle Architecture - Off-Chain AI to On-Chain Decision
---
flowchart TB
    classDef step  fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef store fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef chain fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111

    subgraph ML[" Off-chain ML scoring "]
        direction LR
        FEAT["Feature engineering<br/>22 features"]:::step
        RF["RF + iForest + stacker"]:::step
        SHAP["SHAP + Authority Brief"]:::step
        FEAT --> RF --> SHAP
    end

    subgraph DON[" Chainlink Functions DON "]
        direction LR
        N1["Node 1"]:::step
        N2["Node 2"]:::step
        N3["Node 3"]:::step
        CONS["DON consensus"]:::step
        N1 & N2 & N3 --> CONS
    end

    subgraph CHAIN[" On-chain contracts "]
        direction LR
        LC["LoanController<br/>commit → reveal"]:::chain
        LB["LocalBankPool<br/>SCORE_REVEALED gate"]:::chain
        FX["FXModule · price feeds"]:::chain
        AUTO["Automation upkeep"]:::chain
        POR["Proof of Reserve"]:::chain
    end

    ML --> DON
    SHAP --> CONS
    CONS --> LC --> LB
    LC -.-> FX & AUTO & POR
