    SAVINGS_ACCOUNT {
        bigint account_id PK
        bigint borrower_id FK
        numeric balance
        numeric yield_bps
    }
    LOAN_GROUP {
        bigint group_id PK
        bigint local_bank_id FK
        int member_count
        numeric shared_collateral
    }
    GROUP_MEMBER {
        bigint group_id FK
        bigint borrower_id FK
        numeric share
        string consent_sig
    }
    INTERBANK_LOAN {
        bigint loan_id PK
        bigint lender_bank_id FK
        bigint borrower_bank_id FK
        numeric principal
        string status
    }
    SYNDICATE {
        bigint syndicate_id PK
        bigint lead_arranger_id FK
        numeric total_amount
        string status
    }
    TRANCHED_POOL {
        bigint pool_id PK
        bigint local_bank_id FK
        numeric senior_principal
        numeric junior_principal
    }
    NETTING_BATCH {
        bigint batch_id PK
        int tier
        string batch_root
    }
