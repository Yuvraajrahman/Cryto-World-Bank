{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://cryto-world-bank-api.vercel.app/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://cryto-world-bank-api.vercel.app/health"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
