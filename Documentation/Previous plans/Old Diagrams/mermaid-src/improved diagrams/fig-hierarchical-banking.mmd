---
title: Four-Tier Capital Flow - USDC Retail, Multi-Direction
---
flowchart TB
    classDef tier fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.6px,color:#111111
    classDef ent  fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef note fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111,stroke-dasharray:3 3

    subgraph CORE[" Downward capital allocation "]
        direction LR
        WB["<b>World Bank Reserve</b><br/>Global USDC/ETH custody<br/>Reserve ratio enforced"]:::tier
        NB["<b>National Bank</b><br/>Regional allocation<br/>Inter-NB netting"]:::tier
        LB["<b>Local Bank</b><br/>Retail origination<br/>Group + individual loans"]:::tier
        CL["<b>Client / Group</b><br/>USDC loans · installments<br/>SBT credit passport"]:::ent

        WB -- "allocateCapital ↓" --> NB
        NB -- "allocateCapital ↓" --> LB
        LB -- "disburse USDC" --> CL
    end

    subgraph REPAY[" Upward repayment cascade "]
        direction LR
        CL2["Client repayments"]:::ent -. "principal + interest" .-> LB2["Local Bank"]:::tier
        LB2 -. "cascade ↑" .-> NB2["National Bank"]:::tier
        NB2 -. "cascade ↑" .-> WB2["World Bank"]:::tier
    end

    subgraph SIDE[" Same-tier & surplus flows "]
        direction LR
        subgraph SAME[" Same-tier IBLP "]
            direction TB
            LBA["LB-A surplus"]:::tier <--> LBB["LB-B deficit"]:::tier
        end
        subgraph UP[" UpwardDepositFacility "]
            direction TB
            LBs["LB surplus USDC"]:::tier -.-> NBu["NB parent"]:::tier -.-> WBu["WB reserve"]:::tier
        end
    end

    CORE --> REPAY
    REPAY ~~~ SIDE
