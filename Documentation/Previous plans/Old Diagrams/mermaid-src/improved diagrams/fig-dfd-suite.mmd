---
title: Data-Flow Diagrams - Context and Level-1 Decomposition
---
flowchart TB
    classDef ext   fill:#FFFFFF,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef proc  fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef store fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef sys   fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111

    subgraph L0[" Level-0 context "]
        direction LR
        BORR(("Client")):::ext
        APV(("Approver")):::ext
        CL(("Chainlink")):::ext
        CWB["CWB Platform"]:::sys
        BORR & APV --> CWB
        CL <--> CWB
    end

    subgraph L1A[" Level-1 lending "]
        direction LR
        P1["Origination"]:::proc
        P2["ML + DON"]:::proc
        P3["Disbursement"]:::proc
        D1[("PostgreSQL")]:::store
        D2[("On-chain")]:::store
        P1 --> P2 --> P3 --> D2
        P1 & P2 --> D1
    end

    subgraph L1B[" Level-1 treasury "]
        direction LR
        Q1["SavingsVault"]:::proc
        Q2["IBLP · Syndicate"]:::proc
        Q3["NettingEngine"]:::proc
        E1[("Capital pools")]:::store
        Q1 & Q2 & Q3 --> E1
    end

    L0 --> L1A
    L0 --> L1B
