flowchart TB
  subgraph CHAIN["On-Chain (EVM) &mdash; authoritative financial state"]
    direction TB
    C1["Reserve balances &amp; capital allocation"]
    C2["Loan requests, approval, disbursement, repayment"]
    C3["RBAC, CreditPassport, limit enforcement"]
    C1 ~~~ C2 ~~~ C3
  end
  subgraph DB["PostgreSQL &mdash; workflow, PII, and read models"]
    direction TB
    D1["LOAN_REQUEST, KYC hashes, ML assessments"]
    D2["Projection tables (listener-owned)"]
    D3["BLOCKCHAIN_EVENT_LOG"]
    D1 ~~~ D2 ~~~ D3
  end
  WALLET["Wallet-signed transactions"]
  API["Express API (workflow &amp; scoring)"]
  EL["Event listener<br/>(chain &rarr; DB projection)"]

  WALLET --> CHAIN
  API --> D1
  CHAIN --> EL
  EL --> DB

  classDef apex fill:#D6E4F7,stroke:#1B1B1B,stroke-width:1.2px,color:#111111;
  classDef mid fill:#EAF1FB,stroke:#1B1B1B,stroke-width:1.1px,color:#111111;
  classDef neutral fill:#F2F4F7,stroke:#8A8A8A,stroke-width:1px,color:#111111;
  class C1,C2,C3 apex;
  class D1,D2,D3 mid;
  class WALLET,API,EL neutral;
