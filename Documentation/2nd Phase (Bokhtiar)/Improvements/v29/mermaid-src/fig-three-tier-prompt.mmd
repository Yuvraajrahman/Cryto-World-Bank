---
title: Three-Tier System Prompt Assembly — Stable / Context / Volatile
---
flowchart TB
    classDef tier fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef item fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef out  fill:#FFFFFF,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef note fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111,stroke-dasharray:3 3

    ASM["Express.js prompt constructor<br/>(Phase III)"]:::out

    subgraph S[" Stable tier — prefix-cache target "]
        S1["Agent persona · EN/Bengali style"]:::item
        S2["Active toolset schema only<br/>(not all 17 tools)"]:::item
        S3["Human-gate invariant · compliance anchors<br/>(EU AI Act Art. 86 · FATF R.16)"]:::item
    end

    subgraph C[" Context tier — governance / product "]
        C1["Interest rate tier schedule"]:::item
        C2["KYC requirement matrix"]:::item
        C3["Pool capacity policy"]:::item
        C4["AGENT_SKILLS procedure doc<br/>(if task match)"]:::item
    end

    subgraph V[" Volatile tier — rebuilt every turn "]
        V1["Per-user on-chain JSON namespace<br/>(loans · SBT · balances)"]:::item
        V2["Parent session compression_summary"]:::item
        V3["Last N conversation turns"]:::item
    end

    INJ["Injection scan on user fields<br/>(before assembly · Phase II)"]:::note
    CACHE["KV prefix cache reuse<br/>Stable segment identical per session"]:::note

    INJ --> ASM
    S --> ASM
    C --> ASM
    V --> ASM
    ASM --> PROMPT["Full system prompt → Qwen3-8B"]:::out
    S -.-> CACHE

    SAFE["Safety: human-gate in Stable tier<br/>never evicted by compression"]:::note
    S3 -.-> SAFE
