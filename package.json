{
  "name": "crypto-world-bank",
  "version": "2.0.0",
  "private": true,
  "description": "Decentralized Crypto World Bank — a four-tier blockchain lending platform",
  "scripts": {
    "postinstall": "test -f scripts/install-git-hooks.sh && sh scripts/install-git-hooks.sh || true",
    "setup:hooks": "sh scripts/install-git-hooks.sh",
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "node:chain": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "sync:env": "npx tsx scripts/sync-deployment-env.ts",
    "phase1:local": "sh scripts/phase1-local.sh",
    "phase2:local": "sh scripts/phase2-local.sh",
    "phase3:local": "sh scripts/phase3-local.sh",
    "phase-sepolia": "sh scripts/phase-sepolia.sh",
    "verify:phase1": "hardhat run scripts/verify-phase1.ts --network localhost",
    "verify:phase2": "hardhat run scripts/verify-phase2.ts --network localhost",
    "verify:phase3": "hardhat run scripts/verify-phase3.ts --network localhost",
    "verify:phase1:sepolia": "hardhat run scripts/verify-phase1.ts --network sepolia",
    "verify:phase2:sepolia": "hardhat run scripts/verify-phase2.ts --network sepolia",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "start:all": "sh scripts/start-everything.sh",
    "stop:all": "sh scripts/stop-everything.sh",
    "db:setup": "docker compose up -d && cd backend && npm run db:setup",
    "backend:dev": "cd backend && npm run dev",
    "backend:build": "cd backend && npm run build",
    "ml:dev": "cd ml-service && uvicorn app.main:app --reload --port 8000",
    "dev": "sh -c 'for p in 4000 5173 5174; do lsof -ti :$p | xargs kill -9 2>/dev/null || true; done; concurrently -n frontend,backend -c blue,green \"npm run frontend:dev\" \"npm run backend:dev\"'"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20.11.0",
    "chai": "^4.4.1",
    "concurrently": "^9.0.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "hardhat": "^2.22.10",
    "playwright": "^1.49.1",
    "solidity-coverage": "^0.8.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "exceljs": "^4.4.0"
  },
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuvraajrahman/Cryto-World-Bank.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Yuvraajrahman/Cryto-World-Bank/issues"
  },
  "homepage": "https://github.com/Yuvraajrahman/Cryto-World-Bank#readme"
}
