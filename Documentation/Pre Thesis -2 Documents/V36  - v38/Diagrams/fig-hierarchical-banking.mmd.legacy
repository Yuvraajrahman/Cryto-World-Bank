flowchart TB
  WB["World Bank Reserve (Tier 1)<br/>global reserve, reserve ratio"]
  NB["National Bank (Tier 2)<br/>regional allocation"]
  LB["Local Bank (Tier 3)<br/>retail lending, InsuranceFund"]
  CL["Client (Tier 4)<br/>individual / group / SME"]

  WB ==>|"capital allocation"| NB
  NB ==>|"capital allocation"| LB
  LB ==>|"loan disbursement"| CL

  CL -.->|"installment repayment"| LB
  LB -.->|"yield / upward deposit"| NB
  NB -.->|"yield / upward deposit"| WB

  DEF["Default cascade (on borrower default):<br/>1. Local Bank reserve buffer<br/>2. InsuranceFund draw<br/>3. parent tier absorbs residual + role suspension"]
  LB -.->|"on default"| DEF

  classDef apex fill:#D6E4F7,stroke:#1B1B1B,stroke-width:1.2px,color:#111111;
  classDef mid fill:#EAF1FB,stroke:#1B1B1B,stroke-width:1.1px,color:#111111;
  classDef leaf fill:#FFFFFF,stroke:#1B1B1B,stroke-width:1.1px,color:#111111;
  classDef note fill:#F2F4F7,stroke:#8A8A8A,stroke-width:1px,color:#111111;
  class WB apex;
  class NB,LB mid;
  class CL leaf;
  class DEF note;
