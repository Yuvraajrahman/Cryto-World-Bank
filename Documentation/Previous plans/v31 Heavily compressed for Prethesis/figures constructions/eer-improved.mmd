    subgraph SPEC["Specialization — BANK_USER (disjoint, total)"]
        BU[BANK_USER<br/>bank_user_id PK<br/>bank_type discriminator]:::strong
        NBA[NationalBankAdmin]:::sub
        LBA[LocalBankAdmin]:::sub
        APR[Approver]:::sub
        BU -->|d| NBA & LBA & APR
    end

    subgraph WEAK["Weak entity + multi-valued attribute"]
        LN[LOAN<br/>loan_id PK]:::strong
        INS[INSTALLMENT<br/>weak: PK loan_id + installment_number]:::weak
        BR1[BORROWER]:::strong
        IP["{INCOME_PROOF}<br/>separate table for 1NF"]:::multi
        LN ==>|identifying 1:N| INS
        BR1 -.->|1:N multi-valued| IP
    end

    subgraph AGG["Aggregation — loan-centric cluster"]
        BR2[BORROWER]:::strong
        LR[LOAN_REQUEST<br/>association entity]:::strong
        LB[LOCAL_BANK]:::strong
        AGGBOX[LOAN-CENTRIC<br/>aggregation]:::agg
        TX[TRANSACTION]:::strong
        CM[CHAT_MESSAGE]:::strong
