---
title: Auxiliary Banking Modules
---
flowchart TB
    classDef contract fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef step  fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef note  fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111,stroke-dasharray:3 3

    subgraph R1[" "]
        direction LR
        subgraph A[" (a) LiquidationEngine "]
            direction TB
            L1["HF recomputed<br/>Chainlink price feed"]:::step
            L2{HF < 1.0?}:::step
            L3["liquidate() · bonus 5–8%"]:::contract
            L4["Hierarchical queue<br/>if portfolio RR low"]:::step
            L1 --> L2
            L2 -- Yes --> L3 --> L4
            L2 -- No --> L5["Monitor next block"]:::step
        end
        subgraph B[" (b) SavingsVault · FixedDeposit "]
            direction TB
            D1["Depositor USDC"]:::step --> SV["SavingsVault ERC-4626"]:::contract
            D1 --> FD["FixedDeposit ERC-7540"]:::contract
            SV & FD -.-> POOL["Lending pool liquidity"]:::step
        end
    end

    subgraph R2[" "]
        direction LR
        subgraph C[" (c) Credit Passport SBT "]
            direction TB
            SBT["ICreditPassport.getScore()<br/>riskTier · openLoans · hasDefault"]:::contract
            SBT -- "read by GroupPool / external protocols" --> ALL["Cross-bank composability"]:::step
        end
        subgraph D[" (d) Cross-Chain Bridge "]
            direction TB
            POL["Polygon zkEVM Cardona"]:::contract --- CCIP["Chainlink CCIP"]:::contract --- ETH["Ethereum Sepolia"]:::contract
            CCIP -. "reserve updates + SBT mirror only" .-> Note1["Loans stay on origin chain"]:::note
        end
    end

    R1 ~~~ R2
