        AUTO["Chainlink Automation<br/>checkUpkeep / performUpkeep"]:::chain
        POR["Proof of Reserve<br/>WorldBankReserve balance"]:::chain
    end

    SHAP -->|"HTTP score request"| DON
    CONS -->|"encodeUint256(score)"| LC
    LC --> LB
    ML -. "prototype fallback:<br/>commit-reveal relay" .-> LC

    PF["Chainlink Price Feeds"]:::proc --> FX
    AUTO -->|"overdue installments"| LB
    POR -. "external auditor verify" .-> Note1["No trust in admin claims"]:::note
