        AG -.-> ML
    end

    subgraph BOT[" Smart contracts "]
        direction LR
        CORE["WBR · NB · LB"]:::chain
        PROD["SavingsVault · GroupPool"]:::chain
        MEO["IBLP · Syndicate · Netting"]:::chain
        ZK["zkKYC · DID / VC"]:::chain
