PORT=4000

# ============================================================================
# DATABASE — Neon is PRIMARY. The transactional workload (users, banks,
# loans, deposits, groups, ...) runs entirely on Neon + Vercel so the app
# works even when no local machine is running. Get your own Neon project at
# https://neon.tech, then:
#   cd backend && vercel env pull .env.vercel --environment=production
# and copy DATABASE_URL / DATABASE_URL_UNPOOLED from there into this file.
# ============================================================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# LOCAL POSTGRES (legacy/disabled — laptop-primary architecture).
# Only uncomment this (and comment out the Neon DATABASE_URL above) if you
# intentionally want to go back to running Postgres in Docker as the primary
# database. Also see scripts/start-everything.sh, which has matching
# "Docker + Postgres" / "Reverse sync" sections commented out.
# DATABASE_URL=postgresql://cwb:cwb@localhost:5432/crypto_world_bank
# SYNC_NEON_ON_START=1
# NEON_SYNC_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
# SYNC_NEON_INTERVAL_MS=1800000

JWT_SECRET=change_me_in_production
CORS_ORIGIN=http://localhost:5173
CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
WORLD_BANK_ADDRESS=
NATIONAL_BANK_ADDRESS=
LOCAL_BANK_ADDRESS=
MOCK_USDC_ADDRESS=
LOAN_CONTROLLER_ADDRESS=
GOVERNOR_MULTISIG_ADDRESS=
CREDIT_PASSPORT_ADDRESS=
UPWARD_DEPOSIT_ADDRESS=
SAVINGS_VAULT_ADDRESS=
GROUP_LENDING_POOL_ADDRESS=
INTERBANK_LENDING_POOL_ADDRESS=

# Local-only: ML fraud/credit scoring service + AI agent/chatbot LLM.
# These are NOT deployed to Vercel/Neon — they only work while this machine
# is on and running `npm run ml:dev` / `ollama serve`.
ML_SERVICE_URL=http://localhost:8000
LLM_BASE_URL=http://127.0.0.1:1234
LLM_MODEL=qwen3.5-9b-uncensored-hauhaucs-aggressive
