---
title: Onboarding and Identity Flows — Funnel, EIP-712, KYC Ladder
---
flowchart TB
    classDef start  fill:#1F1F1F,color:#FAFAFA,stroke:#1F1F1F
    classDef act    fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef dec    fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef finish fill:#FAFAFA,stroke:#1F1F1F,stroke-width:2px,color:#111111
    classDef funnel fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111

    subgraph F[" Five-stage conversion funnel "]
        direction LR
        F1["1 Browse<br/>(no account)"]:::funnel --> F2["2 ERC-4337 account<br/>(email / phone)"]:::funnel
        F2 --> F3["3 KYC capture<br/>(2–5 min AI)"]:::funnel
        F3 --> F4["4 First USDC loan<br/>(plain language)"]:::funnel
        F4 --> F5["5 Power user<br/>(MetaMask · group)"]:::funnel
    end

    subgraph A[" (a) Income verification "]
        direction TB
        A1((Start)):::start --> A2["Borrower uploads income doc"]:::act
        A2 --> A3["Hash to IPFS · store doc_hash<br/>(on-chain hash only)"]:::act
        A3 --> A4{Bank API or<br/>manual?}:::dec
        A4 -- Bank API --> A5["Open-Banking pull<br/>(read-only consent)"]:::act
        A4 -- Manual --> A6["LB Operator review"]:::act
        A5 --> A7["INSERT INCOME_PROOF"]:::act
        A6 --> A7
        A7 --> A8{Score ≥ threshold?}:::dec
        A8 -- No --> A9["Flag re-submission"]:::act --> AE((End)):::finish
        A8 -- Yes --> A10["Mark verified · bump SBT score"]:::act --> AE
    end

    subgraph B[" (b) Profile management — EIP-712 "]
        direction TB
        B1((Start)):::start --> B2["User opens profile"]:::act
        B2 --> B3{Action?}:::dec
        B3 -- Update --> B4["Sign EIP-712 typed-data v4<br/>(domain · types · message)"]:::act
        B3 -- Read --> B5["Render dashboard"]:::act --> BE((End)):::finish
        B4 --> B6["API verify sig · persist users row"]:::act
        B6 --> B7["Emit ProfileUpdated event"]:::act --> BE
    end

    subgraph C[" (c) Tiered KYC ladder "]
        direction TB
        C1((Start)):::start --> CL0["L0 Unverified · view only"]:::act
        CL0 --> CL1["L1 zkKYC · ≤ 250 USDC"]:::act
        CL1 --> CL2["L2 phone + ID · ≤ 5k USDC"]:::act
        CL2 --> CL3["L3 full KYC · ≤ 25k USDC"]:::act
        CL3 --> CL4["L4 entity + SoF · institutional"]:::act
        CL4 --> CE((End)):::finish
    end
