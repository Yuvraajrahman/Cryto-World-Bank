flowchart TB
    classDef strong fill:#dae8fc,stroke:#6c8ebf,color:#111
    classDef weak fill:#e1d5e7,stroke:#9673a6,color:#111,stroke-dasharray:4 3
    classDef multi fill:#fff2cc,stroke:#d6b656,color:#111
    classDef agg fill:#f8cecc,stroke:#b85450,color:#111
