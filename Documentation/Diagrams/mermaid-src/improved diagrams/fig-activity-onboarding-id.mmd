---
title: Retail Onboarding and Tiered Identity — Activity Flow
---
flowchart LR
    classDef start  fill:#1F1F1F,color:#FFFFFF,stroke:#1F1F1F,stroke-width:2.5px
    classDef finish fill:#FFFFFF,color:#111111,stroke:#1F1F1F,stroke-width:2.5px
    classDef lane   fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1.6px,color:#111111
    classDef act    fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef dec    fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.6px,color:#111111
    classDef tier   fill:#E8E8E8,stroke:#1F1F1F,stroke-width:1.2px,color:#111111
    classDef chain  fill:#FFFFFF,stroke:#1F1F1F,stroke-width:1.2px,color:#111111,stroke-dasharray:4 3

    S(("Start")):::start

    subgraph L1[" Discover "]
        direction TB
        A1["Browse products · rates<br/>L0 — no wallet required"]:::act
        A2{Register<br/>account?}:::dec
        A1 --> A2
    end

    subgraph L2[" Smart account "]
        direction TB
        B1["Email / OAuth sign-in<br/>ERC-4337 account deploy"]:::act
        B2["Paymaster sponsors<br/>bootstrap transactions"]:::act
        B1 --> B2
    end

    subgraph L3[" Document ladder "]
        direction TB
        C1["L1 · NID<br/>+ selfie capture"]:::tier
        C2["L2 · income proof<br/>upload<br/>IPFS → INCOME_PROOF"]:::tier
        C3["L3 · video interview<br/>officer attestation"]:::tier
        C1 --> C2 --> C3
    end

    subgraph L4[" Compliance proofs "]
        direction TB
        D1["Licensed KYC provider<br/>issues W3C VC<br/>+ DID"]:::act
        D2["Generate zkKYC proof<br/>Groth16 circuit"]:::act
        D3["Generate zkAML proof<br/>sanction<br/>non-membership"]:::act
        D1 --> D2 --> D3
    end

    subgraph L5[" On-chain activation "]
        direction TB
        E1["KYCVerifier + AMLVerifier<br/>verify proofs on-chain"]:::chain
        E2{Proofs<br/>valid?}:::dec
        E3["Grant CLIENT role<br/>enforce USDC<br/>tier limits"]:::chain
        E1 --> E2
        E2 -- "Yes" --> E3
    end

    EN(("End")):::finish

    S --> L1
    A2 -- "No" --> EN
    A2 -- "Yes" --> L2 --> L3 --> L4 --> L5
    E2 -- "No" --> R1["Manual review queue<br/>retry or escalate"]:::act --> D2
    E3 --> EN
