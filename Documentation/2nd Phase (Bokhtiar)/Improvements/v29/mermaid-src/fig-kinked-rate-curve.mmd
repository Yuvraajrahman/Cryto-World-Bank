---
title: Kinked Interest Rate Model — Piecewise Utilization Curve
---
flowchart TB
    classDef axis  fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef seg   fill:#F2F2F2,stroke:#1F1F1F,stroke-width:1px,color:#111111
    classDef kink  fill:#E2E2E2,stroke:#1F1F1F,stroke-width:1.4px,color:#111111
    classDef param fill:#FAFAFA,stroke:#1F1F1F,stroke-width:1px,color:#111111,stroke-dasharray:3 3

    subgraph RETAIL[" Retail lending pool — U* = 80% "]
        direction LR
        R0["U = 0%<br/>r = r₀"]:::seg
        R1["0% < U ≤ U*<br/>r = r₀ + r₁·(U/U*)"]:::seg
        RK["U = U* = 80%<br/>kink point"]:::kink
        R2["U* < U ≤ 100%<br/>r = r₀ + r₁ + r₂·((U−U*)/(1−U*))"]:::seg
        R0 --> R1 --> RK --> R2
    end

    subgraph IBLP[" InterBankLendingPool — U*_IB = 90% "]
        direction LR
        I0["U = 0%<br/>r₀^IB"]:::seg
        I1["gentle slope<br/>below kink"]:::seg
        IK["U* = 90%<br/>higher kink"]:::kink
        I2["steep jump<br/>r₂ multiplier"]:::seg
        IB["r_IB(U) ≤ r_downward − δ"]:::param
        I0 --> I1 --> IK --> I2 --> IB
    end

    subgraph PARAMS[" Parameters (on-chain enforced) "]
        direction TB
        P1["r₀ = base rate (bps)"]:::param
        P2["r₁ = slope below kink"]:::param
        P3["r₂ = jump multiplier above kink<br/>require(r₂ ≥ MINIMUM_JUMP_MULTIPLIER)"]:::param
        P4["require(U* ≤ MAXIMUM_KINK_POINT)"]:::param
    end

    RETAIL -. "same piecewise shape" .-> IBLP
